<%!-- Hero Section --%>
<div class="relative bg-black text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-24 md:py-32">
    <div class="md:w-2/3">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        Build powerful web applications with Phxplate
      </h1>
      <p class="text-xl md:text-2xl mb-8">
        Your go-to platform for secure, scalable web applications with built-in subscription management and team collaboration.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <.link navigate="/register">
          <.button variant="outline" class="w-full text-black">Get Started</.button>
        </.link>
        <.link navigate="/about">
          <.button variant="outline" class="w-full text-black">Learn More</.button>
        </.link>
      </div>
    </div>
  </div>
  <div
    class="absolute bottom-0 w-full h-16 bg-white"
    style="clip-path: polygon(0 100%, 100% 0, 100% 100%);"
  >
  </div>
</div>

<%!-- Features Section --%>
<div class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-black mb-4">
        Powerful Features for Everyone
      </h2>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto">
        Our platform offers specialized tools and capabilities for different types of users.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <%!-- Basic Users --%>
      <.card class="hover:shadow-lg transition duration-300">
        <.card_content>
          <div class="rounded-full bg-gray-100 w-12 h-12 flex items-center justify-center my-4">
            <Lucideicons.user class="h-6 w-6 text-black" />
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Basic Users</h3>
          <ul class="text-gray-700 space-y-2">
            <li class="flex items-start">
              <Lucideicons.check class="h-5 w-5 text-black mr-2 mt-0.5" />
              Create personal profile
            </li>
            <li class="flex items-start">
              <Lucideicons.check class="h-5 w-5 text-black mr-2 mt-0.5" />
              Bookmark companies
            </li>
            <li class="flex items-start">
              <Lucideicons.check class="h-5 w-5 text-black mr-2 mt-0.5" />
              Join companies as employee
            </li>
            <li class="flex items-start">
              <Lucideicons.check class="h-5 w-5 text-black mr-2 mt-0.5" />
              Upgrade to admin status
            </li>
          </ul>
        </.card_content>
      </.card>
      
      <!-- Admin Users -->
      <.card class="hover:shadow-lg transition duration-300">
        <.card_content>
          <div class="rounded-full bg-gray-100 w-12 h-12 flex items-center justify-center my-4">
            <Lucideicons.shield_check class="h-6 w-6 text-black" />
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Admin Users</h3>
          <ul class="text-gray-700 space-y-2">
            <li class="flex items-start">
              <Lucideicons.check class="h-5 w-5 text-black mr-2 mt-0.5" />
              Create and manage companies
            </li>
            <li class="flex items-start">
              <Lucideicons.check class="h-5 w-5 text-black mr-2 mt-0.5" />
              Manage company details
            </li>
            <li class="flex items-start">
              <Lucideicons.check class="h-5 w-5 text-black mr-2 mt-0.5" />
              Invite and remove employees
            </li>
            <li class="flex items-start">
              <Lucideicons.check class="h-5 w-5 text-black mr-2 mt-0.5" />
              Access premium features
            </li>
          </ul>
        </.card_content>
      </.card>
      
      <%!-- Super Admin --%>
      <.card class="hover:shadow-lg transition duration-300">
        <.card_content>
          <div class="rounded-full bg-gray-100 w-12 h-12 flex items-center justify-center my-4">
            <Lucideicons.settings class="h-6 w-6 text-black" />
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Super Admin</h3>
          <ul class="text-gray-700 space-y-2">
            <li class="flex items-start">
              <Lucideicons.check class="h-5 w-5 text-black mr-2 mt-0.5" />
              Unlimited company creation
            </li>
            <li class="flex items-start">
              <Lucideicons.check class="h-5 w-5 text-black mr-2 mt-0.5" />
              Delete any user or company
            </li>
            <li class="flex items-start">
              <Lucideicons.check class="h-5 w-5 text-black mr-2 mt-0.5" />
              Modify subscription status
            </li>
            <li class="flex items-start">
              <Lucideicons.check class="h-5 w-5 text-black mr-2 mt-0.5" />
              Complete platform access
            </li>
          </ul>
        </.card_content>
      </.card>
    </div>
  </div>
</div>

<%!-- How It Works Section --%>
<div class="py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-black mb-4">How It Works</h2>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto">
        Get your project from idea to launch in three simple steps.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <%!-- Step 1 --%>
      <.card class="hover:shadow-lg transition duration-300">
        <.card_content class="text-center">
          <div class="rounded-full bg-black w-12 h-12 flex items-center justify-center mx-auto my-4 text-white font-bold">
            1
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Purchase Access</h3>
          <p class="text-gray-700">
            Choose a subscription plan that matches your project needs and budget. Start small and scale up as you grow.
          </p>
        </.card_content>
      </.card>
      
      <%!-- Step 2 --%>
      <.card class="hover:shadow-lg transition duration-300">
        <.card_content class="text-center">
          <div class="rounded-full bg-black w-12 h-12 flex items-center justify-center mx-auto my-4 text-white font-bold">
            2
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Build Your Perfect Idea</h3>
          <p class="text-gray-700">
            Create companies, invite team members, and use our robust tools to bring your vision to life.
          </p>
        </.card_content>
      </.card>
      
      <%!-- Step 3 --%>
      <.card class="hover:shadow-lg transition duration-300">
        <.card_content class="text-center">
          <div class="rounded-full bg-black w-12 h-12 flex items-center justify-center mx-auto my-4 text-white font-bold">
            3
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Launch to the World</h3>
          <p class="text-gray-700">
            Deploy your completed project with confidence, backed by our secure and scalable infrastructure.
          </p>
        </.card_content>
      </.card>
    </div>
  </div>
</div>

<%!-- Use Cases Section --%>
<div class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-black mb-4">Use Cases</h2>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto">
        Our platform is versatile enough to power a wide range of applications.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <%!-- Enterprise --%>
      <.card class="border border-gray-200 hover:shadow-lg transition duration-300">
        <.card_content>
          <div class="rounded-full bg-gray-100 w-12 h-12 flex items-center justify-center my-4">
            <Lucideicons.building class="h-6 w-6 text-black" />
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Enterprise Solutions</h3>
          <p class="text-gray-700 mb-4">
            Build internal tools, team collaboration platforms, and workflow management systems for your organization.
          </p>
        </.card_content>
      </.card>
      
      <%!-- Social Apps --%>
      <.card class="border border-gray-200 hover:shadow-lg transition duration-300">
        <.card_content>
          <div class="rounded-full bg-gray-100 w-12 h-12 flex items-center justify-center my-4">
            <Lucideicons.message_circle class="h-6 w-6 text-black" />
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Social Applications</h3>
          <p class="text-gray-700 mb-4">
            Create community platforms, forums, and social networks with user management and content moderation.
          </p>
        </.card_content>
      </.card>
      
      <%!-- SaaS Products --%>
      <.card class="border border-gray-200 hover:shadow-lg transition duration-300">
        <.card_content>
          <div class="rounded-full bg-gray-100 w-12 h-12 flex items-center justify-center my-4">
            <Lucideicons.circle_dollar_sign class="h-6 w-6 text-black" />
          </div>
          <h3 class="text-xl font-bold text-black mb-2">SaaS Products</h3>
          <p class="text-gray-700 mb-4">
            Launch subscription-based services with built-in billing, user management, and analytics capabilities.
          </p>
        </.card_content>
      </.card>
    </div>
  </div>
</div>

<%!-- CTA Section --%>
<.cta />