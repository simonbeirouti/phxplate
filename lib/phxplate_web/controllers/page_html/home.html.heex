<%!-- How It Works Section --%>
<div class="py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-black mb-4">How It Works</h2>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto">
        Get your project from idea to launch in three simple steps.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <%!-- Step 1 --%>
      <.card class="hover:shadow-lg transition duration-300">
        <.card_content class="text-center">
          <div class="rounded-full bg-black w-12 h-12 flex items-center justify-center mx-auto my-4 text-white font-bold">
            1
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Purchase Access</h3>
          <p class="text-gray-700">
            Choose a subscription plan that matches your project needs and budget. Start small and scale up as you grow.
          </p>
        </.card_content>
      </.card>
      
      <%!-- Step 2 --%>
      <.card class="hover:shadow-lg transition duration-300">
        <.card_content class="text-center">
          <div class="rounded-full bg-black w-12 h-12 flex items-center justify-center mx-auto my-4 text-white font-bold">
            2
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Build Your Perfect Idea</h3>
          <p class="text-gray-700">
            Create companies, invite team members, and use our robust tools to bring your vision to life.
          </p>
        </.card_content>
      </.card>
      
      <%!-- Step 3 --%>
      <.card class="hover:shadow-lg transition duration-300">
        <.card_content class="text-center">
          <div class="rounded-full bg-black w-12 h-12 flex items-center justify-center mx-auto my-4 text-white font-bold">
            3
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Launch to the World</h3>
          <p class="text-gray-700">
            Deploy your completed project with confidence, backed by our secure and scalable infrastructure.
          </p>
        </.card_content>
      </.card>
    </div>
  </div>
</div>

<%!-- Use Cases Section --%>
<div class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-black mb-4">Use Cases</h2>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto">
        Our platform is versatile enough to power a wide range of applications.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <%!-- Enterprise --%>
      <.card class="border border-gray-200 hover:shadow-lg transition duration-300">
        <.card_content>
          <div class="rounded-full bg-gray-100 w-12 h-12 flex items-center justify-center my-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 text-black"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Enterprise Solutions</h3>
          <p class="text-gray-700 mb-4">
            Build internal tools, team collaboration platforms, and workflow management systems for your organization.
          </p>
        </.card_content>
      </.card>
      
      <%!-- Social Apps --%>
      <.card class="border border-gray-200 hover:shadow-lg transition duration-300">
        <.card_content>
          <div class="rounded-full bg-gray-100 w-12 h-12 flex items-center justify-center my-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 text-black"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"
              />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Social Applications</h3>
          <p class="text-gray-700 mb-4">
            Create community platforms, forums, and social networks with user management and content moderation.
          </p>
        </.card_content>
      </.card>
      
      <%!-- SaaS Products --%>
      <.card class="border border-gray-200 hover:shadow-lg transition duration-300">
        <.card_content>
          <div class="rounded-full bg-gray-100 w-12 h-12 flex items-center justify-center my-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 text-black"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-black mb-2">SaaS Products</h3>
          <p class="text-gray-700 mb-4">
            Launch subscription-based services with built-in billing, user management, and analytics capabilities.
          </p>
        </.card_content>
      </.card>
    </div>
  </div>
</div>

<%!-- CTA Section --%>
<.cta />