<%!-- Hero Section --%>
<div class="relative bg-black text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-24 md:py-32">
    <div class="md:w-2/3">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        Build powerful web applications with Phxplate
      </h1>
      <p class="text-xl md:text-2xl mb-8">
        Your go-to platform for secure, scalable web applications with built-in subscription management and team collaboration.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <.link navigate="/signup">
          <.button variant="outline" class="w-full text-black">Get Started</.button>
        </.link>
        <.link navigate="/about">
          <.button variant="outline" class="w-full text-black">Learn More</.button>
        </.link>
      </div>
    </div>
  </div>
  <div
    class="absolute bottom-0 w-full h-16 bg-white"
    style="clip-path: polygon(0 100%, 100% 0, 100% 100%);"
  >
  </div>
</div>

<%!-- Features Section --%>
<div class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-black mb-4">
        Powerful Features for Everyone
      </h2>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto">
        Our platform offers specialized tools and capabilities for different types of users.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <%!-- Basic Users --%>
      <.card class="hover:shadow-lg transition duration-300">
        <.card_content>
          <div class="rounded-full bg-gray-100 w-12 h-12 flex items-center justify-center my-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 text-black"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-black mb-2">Basic Users</h3>
          <ul class="text-gray-700 space-y-2">
            <li class="flex items-start">
              <svg
                class="h-5 w-5 text-black mr-2 mt-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              Create personal profile
            </li>
            <li class="flex items-start">
              <svg
                class="h-5 w-5 text-black mr-2 mt-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              Bookmark companies
            </li>
            <li class="flex items-start">
              <svg
                class="h-5 w-5 text-black mr-2 mt-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              Join companies as employee
            </li>
            <li class="flex items-start">
              <svg
                class="h-5 w-5 text-black mr-2 mt-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              Upgrade to admin status
