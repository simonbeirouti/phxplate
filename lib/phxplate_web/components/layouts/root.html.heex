<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%= if assigns[:current_user] do %>
      <meta name="user-token" content={Phoenix.Token.sign(PhxplateWeb.Endpoint, "user socket", @current_user.id)} />
    <% end %>
    <link rel="icon" type="image/png" href={~p"/images/favicon.png"} />

    <.live_title>
      {assigns[:page_title]}
    </.live_title>

    <%= if assigns[:page_title] do %>
      <meta
        name="twitter:title"
        content={"#{assigns[:page_title]}"}
      />
      <meta
        property="og:title"
        content={"#{assigns[:page_title]}"}
      />
    <% else %>
      <meta name="twitter:title" content={Phxplate.config([:title])} />
      <meta property="og:title" content={Phxplate.config([:title])} />
    <% end %>

    <%= if assigns[:page_description] do %>
      <meta name="description" content={assigns[:page_description]} />
      <meta name="twitter:description" content={assigns[:page_description]} />
      <meta property="og:description" content={assigns[:page_description]} />
    <% else %>
      <meta name="description" content={Phxplate.config([:description])} />
      <meta name="twitter:description" content={Phxplate.config([:description])} />
      <meta property="og:description" content={Phxplate.config([:description])} />
    <% end %>

    <meta name="twitter:image:src" content={assigns[:page_image]} />
    <meta property="og:image" content={assigns[:page_image]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <%= if assigns[:page_url] do %>
      <meta property="og:url" content={"#{assigns[:page_url]}"} />
    <% end %>

    <meta name="twitter:site" content="@phxplate" />
    <meta property="og:site_name" content="Phxplate" />
    <meta property="og:type" content="website" />

    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-white">
    <%= if assigns[:real_user] do %>
      <div class="fixed bottom-4 right-4 z-50 bg-yellow-500 text-white px-4 py-2 rounded-lg shadow-lg text-sm">
        <div class="flex items-center">
          <span class="mr-2">Currently impersonating user.</span>
          <.link
            href={~p"/dashboard/stop_impersonating"}
            class="underline font-medium hover:text-yellow-100"
          >
            Stop impersonating
          </.link>
        </div>
      </div>
    <% end %>
    <.flash_group flash={@flash} />
    <PhxplateWeb.Components.NavComponent.nav
      current_user={@current_user}
      current_path={@current_path}
    />
    {@inner_content}
    <PhxplateWeb.Components.ChatButton.chat_button current_user={@current_user} />
  </body>
</html>
