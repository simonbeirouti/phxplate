## Common Patterns

### Data Synchronization
```svelte
<script>
  export let data
  export let live

  function updateData(newData) {
    live.pushEvent("update_data", { data: newData })
  }
</script>
```

### Real-time Updates
```svelte
<script>
  export let live
  
  function subscribeToUpdates() {
    live.pushEvent("subscribe", { topic: "updates" })
  }
</script>
```

### Error Handling
```svelte
<script>
  export let live
  let error = null

  function handleError(err) {
    error = err
    live.pushEvent("error_occurred", { error: err.message })
  }
</script>
```
